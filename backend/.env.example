# Server Port
PORT=5000

# MongoDB Connection String (Atlas Replica Set or Local Mongo)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/memed?retryWrites=true&w=majority

# JWT Signing Secret Key (Minimum 32 random characters)
JWT_SECRET=your_super_secret_jwt_random_key_here

# Redis Cache URL (Optional bonus feature: defaults to redis://localhost:6379, falls back gracefully if absent)
REDIS_URL=redis://localhost:6379
